# ── OpenRouter API ─────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model used for the main conversation agent
# Any OpenRouter model ID works, e.g.:
#   anthropic/claude-3.5-sonnet  (default, best quality)
#   anthropic/claude-3-haiku     (faster, cheaper)
#   openai/gpt-4o
#   google/gemini-flash-1.5
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: use a cheaper/faster model just for HTML extraction
# Falls back to OPENROUTER_MODEL if not set
EXTRACTION_MODEL=anthropic/claude-3.5-haiku
